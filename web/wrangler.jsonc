{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newsspur",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "vars": {
    "VAPID_PUBLIC_KEY": "BEmk73DAP0FlV54vTcTUVaYuKEP20g9SmHlXLI7OwLrqivsYrQdiq3ffP01jKB-5uDuYu5xlS9WZKEYddj1y_Ug"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsspur",
      "database_id": "05b07341-c56c-4942-bd68-323d81131e35"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REELS",
      "bucket_name": "newsspur-reels"
    }
  ],
  "routes": [
    {
      "pattern": "newsspur.de",
      "custom_domain": true
    },
    {
      "pattern": "www.newsspur.de",
      "custom_domain": true
    }
  ]
}
